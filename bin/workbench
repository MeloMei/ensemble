#!/bin/sh
set -eu
workbench_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
workbench_runtime="$workbench_root/../../MacOS/Ensemble"
if [ -x "$workbench_runtime" ]; then
  exec env ELECTRON_RUN_AS_NODE=1 "$workbench_runtime" "$workbench_root/dist/main/cli.js" "$@"
fi
exec node "$workbench_root/dist/main/cli.js" "$@"
